{
  "files.exclude": {
    ".gitignore": true,
    "package.json": true,
    "pnpm-lock.yaml": true,
    "pnpm-workspace.yaml": true,
    "node_modules": true,
    ".venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true
  },
  "ruff.configuration": "${workspaceFolder}/tools/config/ruff.toml",
  "editor.tabSize": 2,
  "[python]": {
    "editor.tabSize": 4
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
