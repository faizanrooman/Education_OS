# Environment variables consumed by payment-sbiepay. Prefix every key with the module name.
# Never commit real values. Gateway URLs and the request format come from the SBIePay merchant integration kit.
# Platform merchant account, used for plan upgrades (purpose=subscription).
# Fee payments (purpose=fee) use each organisation's own account, set through PUT /merchant-account.
# PAYMENT_SBIEPAY_MODE=sandbox
# PAYMENT_SBIEPAY_MERCHANT_ID=
# PAYMENT_SBIEPAY_ENCRYPTION_KEY=
# PAYMENT_SBIEPAY_GATEWAY_URL=
# PAYMENT_SBIEPAY_VERIFY_URL=
# PAYMENT_SBIEPAY_REFUND_URL=
# Public base URL the gateway returns the browser to (POST /callbacks/sbiepay is appended).
# PAYMENT_SBIEPAY_CALLBACK_BASE_URL=
# Hosts allowed in return_url and notify_url, comma separated.
# PAYMENT_SBIEPAY_ALLOWED_RETURN_HOSTS=
# HMAC key for the X-Payment-Signature header on notify_url posts.
# PAYMENT_SBIEPAY_NOTIFY_SECRET=
# PAYMENT_SBIEPAY_SESSION_TTL_MINUTES=30
# Payments still pending after this many minutes are re-verified and, if unknown at the gateway, expired.
# PAYMENT_SBIEPAY_PENDING_VERIFY_AFTER_MINUTES=20
