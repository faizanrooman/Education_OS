# Environment variables consumed by asset-management. Prefix every key with the module name.
# Organisation-wide defaults; categories and assets may override depreciation and verification.
ASSET_MANAGEMENT_DEFAULT_CURRENCY=INR
ASSET_MANAGEMENT_TAG_PREFIX=AST
ASSET_MANAGEMENT_DEFAULT_VERIFICATION_INTERVAL_MONTHS=12
ASSET_MANAGEMENT_VERIFICATION_DUE_SOON_DAYS=30
ASSET_MANAGEMENT_FINANCIAL_YEAR_START_MONTH=4
