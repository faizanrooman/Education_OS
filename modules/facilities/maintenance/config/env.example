# Environment variables consumed by maintenance. Prefix every key with the module name.
# Organisation-wide defaults; a category may override the SLA hours.
MAINTENANCE_SLA_RESPONSE_HOURS_URGENT=1
MAINTENANCE_SLA_RESPONSE_HOURS_HIGH=4
MAINTENANCE_SLA_RESPONSE_HOURS_MEDIUM=24
MAINTENANCE_SLA_RESPONSE_HOURS_LOW=72
MAINTENANCE_SLA_RESOLUTION_HOURS_URGENT=8
MAINTENANCE_SLA_RESOLUTION_HOURS_HIGH=48
MAINTENANCE_SLA_RESOLUTION_HOURS_MEDIUM=120
MAINTENANCE_SLA_RESOLUTION_HOURS_LOW=336
MAINTENANCE_AUTO_CLOSE_DAYS=3
MAINTENANCE_REOPEN_WINDOW_DAYS=7
MAINTENANCE_DEFAULT_LEAD_DAYS=3
MAINTENANCE_DEFAULT_CURRENCY=INR
